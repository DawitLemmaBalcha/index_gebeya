# =============================================================================
# Index Gebeya — Environment Variable Reference
# =============================================================================
#
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# The `.env` file is read by docker-compose.yml and injected into the
# appropriate containers. It is git-ignored — never commit real secrets here.
#
# =============================================================================


# =============================================================================
# 1. POSTGRESQL DATABASE (Used by: docker-compose, backend)
# =============================================================================
# The database container uses these to initialize the PostgreSQL instance.
# The backend reads them to construct its SQLAlchemy connection string.
#
# NOTE for Docker: set DB_HOST=db (the docker-compose service name).
# NOTE for local dev: set DB_HOST=localhost and DB_PORT=5433.

DB_USER=suq_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=suq_db


# =============================================================================
# 2. AI / LLM PROVIDERS (Used by: backend)
# =============================================================================
# The backend uses a hybrid router:
#   - Primary:  Groq (Llama 3.1 8B) for text extraction and LLM verification
#   - Fallback: Google Gemini (2.0 Flash Lite) if Groq fails
#   - Local:    CLIP (ViT-B-32) for image vectorization — no API key needed
#
# IMPORTANT NAMING NOTE:
#   The .env key is GOOGLE_API_KEY, but docker-compose maps it to the
#   GEMINI_API_KEY environment variable inside the container, because that
#   is what the Python code expects (os.getenv("GEMINI_API_KEY")).
#   You do NOT need to set GEMINI_API_KEY directly here.

# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Get your key at: https://aistudio.google.com/apikey
# This will be injected into the container as GEMINI_API_KEY.
GOOGLE_API_KEY=AIzaY_YOUR_GOOGLE_API_KEY_HERE


# =============================================================================
# 3. TELEGRAM BOT (Used by: backend, listener)
# =============================================================================
# The backend uses this to validate Mini App initData (HMAC-SHA256).
# The listener uses this to run the Telegram bot (polling, commands, DM delivery).
#
# Get your token from @BotFather on Telegram: https://t.me/BotFather

TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz


# =============================================================================
# 4. LISTENER / INGESTION WORKER (Used by: listener)
# =============================================================================
# The listener pulls posts from monitored Telegram channels and queues them
# for ingestion by the backend. These settings control pacing and resilience.

# URL of the backend API from the listener's perspective.
# Inside Docker, the backend is reachable at its service name.
API_BASE=http://api:8000

# Seconds to wait between processing each queued post.
# Controls the ingestion rate to stay within AI provider rate limits.
# Default: 30.0
LISTENER_INTERVAL=30.0

# Maximum number of retries for a failed ingestion before the post is dropped
# (a "dead letter"). Each retry waits LISTENER_INTERVAL seconds.
# Default: 10
LISTENER_MAX_RETRIES=10


# =============================================================================
# 5. SEARCH TUNING (Used by: backend)
# =============================================================================
# These control the hybrid search scoring weights and default result limit.
# They have sensible defaults and rarely need changing.

# Weight of the visual/semantic (vector) score in hybrid search.
# Must add up to 1.0 with SEARCH_LEXICAL_WEIGHT.
# Default: 0.6
# SEARCH_SEMANTIC_WEIGHT=0.6

# Weight of the text/lexical (pg_trgm) score in hybrid search.
# Default: 0.4
# SEARCH_LEXICAL_WEIGHT=0.4

# Default number of results returned when no explicit limit is specified.
# Default: 20
# SEARCH_RESULT_LIMIT=20


# =============================================================================
# 6. FRONTEND (Used by: frontend)
# =============================================================================
# The frontend uses relative API paths (empty string) for production because
# Apache/Nginx proxies requests to the backend. For local Vite dev outside
# Docker, uncomment and set this if you need to point to a remote backend.
#
# VITE_API_BASE_URL=http://localhost:8000
