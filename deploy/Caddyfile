# Versioned copy of the production Caddy config (host: /home/ubuntu/caddy/Caddyfile). Keep in sync when routing changes.
indexgebeya.cfd {
    # Security headers
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Content-Type-Options "nosniff"

    # API routes → FastAPI backend
    handle /search* {
        reverse_proxy index_api:8000
    }
    handle /items* {
        reverse_proxy index_api:8000
    }
    handle /reviews* {
        reverse_proxy index_api:8000
    }
    handle /alerts* {
        reverse_proxy index_api:8000
    }
    handle /notifications* {
        reverse_proxy index_api:8000
    }
    handle /activity* {
        reverse_proxy index_api:8000
    }
    handle /feed* {
        reverse_proxy index_api:8000
    }
    handle /parse-telegram-post* {
        reverse_proxy index_api:8000
    }
    handle /media* {
        reverse_proxy index_api:8000
    }
    handle /admin* {
        reverse_proxy index_api:8000
    }
    handle /channels* {
        reverse_proxy index_api:8000
    }
    handle /subscriptions* {
        reverse_proxy index_api:8000
    }
    # NB-49..NB-54: ops console API handles (blueprint D7). The /ops page
    # itself and any other /ops/* path continue through the SPA catch-all.
    handle /ops/auth* {
        reverse_proxy index_api:8000
    }
    handle /ops/health* {
        reverse_proxy index_api:8000
    }
    handle /ops/monetization* {
        reverse_proxy index_api:8000
    }
    handle /ops/settings* {
        reverse_proxy index_api:8000
    }
    handle /ops/audit* {
        reverse_proxy index_api:8000
    }
    handle /ops/payments* {
        reverse_proxy index_api:8000
    }
    handle /ops/tools* {
        reverse_proxy index_api:8000
    }
    handle /ops/internal* {
        reverse_proxy index_api:8000
    }
    handle /ops/radar* {
        reverse_proxy index_api:8000
    }
    handle /ops/quality* {
        reverse_proxy index_api:8000
    }
    handle /ops/items* {
        reverse_proxy index_api:8000
    }
    handle /ops/users* {
        reverse_proxy index_api:8000
    }
    handle /ops/actions* {
        reverse_proxy index_api:8000
    }
    handle /ops/diagnostics* {
        reverse_proxy index_api:8000
    }

    # Everything else → React SPA
    handle {
        reverse_proxy index_frontend:5173
    }
}

# WWW to non-WWW redirect
www.indexgebeya.cfd {
    redir https://indexgebeya.cfd{uri} permanent
}